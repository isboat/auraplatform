@model StaffUser
@{ViewData["Title"]="Manage account";}<a class="back" asp-action="Index">← Back to people</a><section class="panel user-card"><h2>@Model.Name</h2><p>@Model.Email</p>@if(Model.IsAdmin){<div class="flash">Administrator accounts are protected and cannot be managed here.</div>}else{<div class="action-list"><form asp-action="Reviewer" method="post"><input type="hidden" name="id" value="@Model.Id"><input type="hidden" name="enabled" value="@(!Model.IsReviewer).ToString().ToLower()"><button>@(Model.IsReviewer?"Remove reviewer access":"Grant reviewer access")</button></form><form asp-action="Promote" method="post"><input type="hidden" name="id" value="@Model.Id"><button onclick="return confirm('Grant full administrator access? This cannot be reversed here.')">Promote to administrator</button></form><form asp-action="Reset" method="post"><input type="hidden" name="id" value="@Model.Id"><button>Send password reset</button></form><form asp-action="Block" method="post"><input type="hidden" name="id" value="@Model.Id"><input type="hidden" name="blocked" value="@(!Model.IsBlocked).ToString().ToLower()"><input name="reason" required placeholder="Reason"><button class="danger">@(Model.IsBlocked?"Unblock account":"Block account")</button></form></div>}</section>
