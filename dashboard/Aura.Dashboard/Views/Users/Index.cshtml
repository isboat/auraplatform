@model PageResult<StaffUser>
@{ViewData["Title"]="People & access";}<form class="filters"><input name="query" placeholder="Search name or email"><select name="role"><option value="">Every role</option><option value="ContentReviewer">Reviewers</option><option value="Administrator">Administrators</option></select><button>Search people</button></form><section class="panel"><table><thead><tr><th>Person</th><th>Access</th><th>State</th><th></th></tr></thead><tbody>@foreach(var x in Model.Items){<tr><td><b>@x.Name</b><small>@x.Email</small></td><td>@(x.IsAdmin?"Administrator":x.IsReviewer?"Content reviewer":"Member")</td><td><span class="badge @(x.IsBlocked?"rejected":"approved")">@(x.IsBlocked?"Blocked":x.EmailVerified?"Active":"Unverified")</span></td><td><a class="link" asp-action="Details" asp-route-id="@x.Id">Manage →</a></td></tr>}</tbody></table></section>
