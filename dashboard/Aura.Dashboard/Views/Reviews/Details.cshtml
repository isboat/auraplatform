@model ManagedMedia
@{ ViewData["Title"] = "Review upload"; }

<a class="back" asp-action="Index">← Back to queue</a>
<div class="detail-grid">
    <section class="panel preview">
        <h2>@Model.Title</h2>
        @if (Model.MediaType == "image")
        {
            <img src="@ViewBag.PreviewUrl" alt="Preview of @Model.Title">
        }
        else if (Model.MediaType == "video")
        {
            <video controls src="@ViewBag.PreviewUrl"></video>
        }
        else
        {
            <audio controls src="@ViewBag.PreviewUrl"></audio>
        }
        <p>@Model.Description</p>
        <div class="tags">
            @foreach (var tag in Model.Tags)
            {
                <span>#@tag</span>
            }
        </div>
    </section>
    <section class="panel facts">
        <h3>Upload details</h3>
        <dl>
            <dt>Status</dt><dd><span class="badge pending">In review</span></dd>
            <dt>Type</dt><dd>@Model.MediaType · @Model.ContentType</dd>
            <dt>Uploader</dt><dd>@Model.OwnerName</dd>
            <dt>Uploaded</dt><dd>@Model.CreatedAt.ToLocalTime().ToString("f")</dd>
        </dl>
        @{ ViewData["MetadataTitle"] = "Upload metadata"; ViewData["MetadataEmptyMessage"] = "Metadata was not captured for this upload."; }
        <partial name="_ClientMetadata" model="Model.UploadMetadata" />
        <form asp-action="Decide" method="post">
            <input type="hidden" name="id" value="@Model.Id">
            <label for="reason">Internal comment / rejection reason</label>
            <textarea id="reason" name="reason" maxlength="500" placeholder="Required when rejecting"></textarea>
            <div class="actions">
                <button name="approve" value="true" onclick="return confirm('Approve this upload?')">✓ Approve</button>
                <button class="danger" name="approve" value="false" onclick="return confirm('Reject this upload?')">× Reject</button>
            </div>
        </form>
    </section>
</div>
