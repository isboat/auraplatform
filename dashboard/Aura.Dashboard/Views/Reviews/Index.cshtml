@model PageResult<ManagedMedia>
@{ViewData["Title"]="Review queue";}<form class="filters" method="get"><input name="query" placeholder="Search title, uploader or tag"><select name="type"><option value="">All media types</option><option>video</option><option>image</option><option>audio</option></select><input type="date" name="from"><input type="date" name="to"><button>Filter queue</button></form><section class="panel"><div class="panel-title"><h2>Uploads awaiting a decision</h2><span>@Model.Total pending</span></div><table><thead><tr><th>Media</th><th>Uploader</th><th>Uploaded</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var x in Model.Items){<tr><td><b>@x.Title</b><small>@x.MediaType · @string.Join(", ",x.Tags)</small></td><td>@x.OwnerName</td><td>@x.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</td><td><span class="badge pending">● In review</span></td><td><a class="link" asp-action="Details" asp-route-id="@x.Id">Review →</a></td></tr>}</tbody></table>@if(Model.Items.Count==0){<div class="empty">Queue clear. There are no matching uploads to review.</div>}</section>
