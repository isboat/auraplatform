@model DashboardMetrics
@{ViewData["Title"]="Operational overview";}<section class="hero"><div><span class="eyebrow">PLATFORM PULSE</span><h2>Everything that needs your attention, in one place.</h2><p>Review activity, member health and the media catalogue at a glance.</p></div><a class="button" asp-controller="Reviews">Open review queue →</a></section><h3>Content summary</h3><div class="cards"><a asp-controller="Reviews"><span>Awaiting review</span><strong>@Model.Pending</strong><em>Needs attention</em></a><div><span>Total media</span><strong>@Model.TotalMedia</strong><em>@Model.Videos video · @Model.Images image · @Model.Audio audio</em></div><div><span>Approved</span><strong>@Model.Approved</strong><em>Available publicly</em></div><div><span>Rejected</span><strong>@Model.Rejected</strong><em>Not discoverable</em></div></div>@if(User.IsInRole(Roles.Administrator)){<h3>Community health</h3><div class="cards"><a asp-controller="Users"><span>Registered users</span><strong>@Model.TotalUsers</strong><em>@Model.VerifiedUsers verified</em></a><div><span>Blocked</span><strong>@Model.BlockedUsers</strong><em>Restricted accounts</em></div><div><span>Review team</span><strong>@Model.Reviewers</strong><em>Content reviewers</em></div><div><span>Administrators</span><strong>@Model.Administrators</strong><em>Full access</em></div></div>}
