@model PageResult<AuditEvent>
@{ViewData["Title"]="Audit trail";}<form class="filters"><input name="type" placeholder="Event type">@if(User.IsInRole(Roles.Administrator)){<input name="actor" placeholder="Actor email"><input name="target" placeholder="Target"><select name="outcome"><option value="">Every outcome</option><option>Succeeded</option><option>Failed</option></select>}<button>Filter events</button></form><section class="panel timeline">@foreach(var x in Model.Items){<article><span class="event-dot"></span><div><b>@x.EventType</b><p>@x.ActorName acted on @(x.TargetDisplay??x.TargetId) @if(x.Reason is not null){<span>— @x.Reason</span>}</p><small>@x.OccurredAtUtc.ToLocalTime().ToString("f") · @x.CorrelationId</small></div><span class="badge approved">@x.Outcome</span></article>}@if(Model.Items.Count==0){<div class="empty">No audit events match these filters.</div>}</section>
