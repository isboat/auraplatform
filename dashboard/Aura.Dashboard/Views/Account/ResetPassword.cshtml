@model Aura.Dashboard.Models.ResetPasswordViewModel
@{ Layout = null; }
<!doctype html>
<html>
<head><meta name="viewport" content="width=device-width"><link rel="stylesheet" href="~/css/site.css"><title>Reset password · Aura Control</title></head>
<body class="login"><main><div class="login-brand">AURA <span>CONTROL</span></div><section class="login-card"><span class="eyebrow">PASSWORD RESET</span><h1>Choose a new password.</h1><p>The reset link can only be used once.</p><form method="post"><div asp-validation-summary="All" class="error"></div><input asp-for="Token" type="hidden"><label asp-for="Password">Password</label><input asp-for="Password" autocomplete="new-password" required><label asp-for="ConfirmPassword">Confirm password</label><input asp-for="ConfirmPassword" autocomplete="new-password" required><button>Reset password →</button></form></section></main></body>
</html>
