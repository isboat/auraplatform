@model PageResult<ManagedMedia>
@{ViewData["Title"]="Media library";}<form class="filters"><input name="query" placeholder="Search media"><select name="status"><option value="">Every status</option><option>InReview</option><option>Approved</option><option>Rejected</option></select><button>Search library</button></form><section class="panel"><table><thead><tr><th>Media</th><th>Owner</th><th>Status</th><th>Destructive action</th></tr></thead><tbody>@foreach(var x in Model.Items){<tr><td><b>@x.Title</b><small>@x.MediaType</small></td><td>@x.OwnerName</td><td><span class="badge">@x.ReviewStatus</span></td><td><form asp-action="Delete" method="post" onsubmit="return confirm('Permanently delete this media and stored asset?')"><input type="hidden" name="id" value="@x.Id"><input name="reason" required placeholder="Deletion reason"><button class="danger">Delete</button></form></td></tr>}</tbody></table></section>
