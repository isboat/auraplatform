@model ManagedMedia
@{ViewData["Title"]="View media";var mediaType=Model.MediaType.ToLowerInvariant();}
<a class="back" asp-action="Index">← Back to media library</a>
<div class="detail-grid">
 <section class="panel preview">
  <h2>@Model.Title</h2>
  @if(mediaType=="image"){<img src="@ViewBag.PreviewUrl" alt="@Model.Title">}
  else if(mediaType=="video"){<video controls preload="metadata" src="@ViewBag.PreviewUrl">Your browser does not support video playback.</video>}
  else if(mediaType=="audio"){<audio controls preload="metadata" src="@ViewBag.PreviewUrl">Your browser does not support audio playback.</audio>}
  else{<p class="empty">A preview is not available for this media type.</p><a class="button" href="@ViewBag.PreviewUrl" target="_blank" rel="noopener">Open media asset</a>}
  <p>@(string.IsNullOrWhiteSpace(Model.Description)?"No description was provided.":Model.Description)</p>
  <div class="tags">@foreach(var tag in Model.Tags){<span>#@tag</span>}</div>
 </section>
 <section class="panel facts">
  <h3>Media details</h3>
  <dl><dt>Status</dt><dd><span class="badge">@Model.ReviewStatus</span></dd><dt>Type</dt><dd>@Model.MediaType · @Model.ContentType</dd><dt>Uploader</dt><dd>@Model.OwnerName</dd><dt>Uploaded</dt><dd>@Model.CreatedAt.ToLocalTime().ToString("f")</dd></dl>
  <form asp-action="Delete" method="post" onsubmit="return confirm('Permanently delete this media and stored asset?')"><input type="hidden" name="id" value="@Model.Id"><label for="reason">Deletion reason</label><textarea id="reason" name="reason" required maxlength="500"></textarea><button class="danger">Delete media</button></form>
 </section>
</div>
