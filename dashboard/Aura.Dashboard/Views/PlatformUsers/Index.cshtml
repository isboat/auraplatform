@model PageResult<PlatformUser>
@{ ViewData["Title"] = "Platform users"; }

<p>Accounts created through the Aura platform registration API.</p>
<form class="filters" method="get">
    <input name="query" value="@Context.Request.Query["query"]" placeholder="Search name or email">
    <select name="verified">
        <option value="">Every verification state</option>
        <option value="true">Verified</option>
        <option value="false">Unverified</option>
    </select>
    <button>Search platform users</button>
</form>
<section class="panel">
    <div class="panel-title"><h2>Registered platform users</h2><span>@Model.Total total</span></div>
    <table><thead><tr><th>Person</th><th>Registered</th><th>State</th><th></th></tr></thead><tbody>
    @foreach (var user in Model.Items)
    {
        <tr>
            <td><b>@user.Name</b><small>@user.Email</small></td>
            <td>@(user.CreatedAt == default ? "Not available" : user.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm"))</td>
            <td><span class="badge @(user.IsBlocked ? "rejected" : user.EmailVerified ? "approved" : "pending")">@(user.IsBlocked ? "Blocked" : user.EmailVerified ? "Verified" : "Unverified")</span></td>
            <td><a class="link" asp-action="Details" asp-route-id="@user.Id">View →</a></td>
        </tr>
    }
    </tbody></table>
    @if (Model.Items.Count == 0) { <div class="empty">No matching platform users were found.</div> }
</section>
