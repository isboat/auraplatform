<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>@ViewData["Title"] · Aura Control</title><link rel="stylesheet" href="~/css/site.css"></head><body><aside><a class="brand" asp-controller="Dashboard">AURA <span>CONTROL</span></a><nav><a asp-controller="Dashboard">Overview</a><a asp-controller="Reviews">Review queue</a>@if(User.IsInRole(Roles.Administrator)){<a asp-controller="Users">People</a><a asp-controller="Media">Media library</a><a asp-controller="Configuration">Configuration</a>}<a asp-controller="Audit">Audit trail</a></nav><form asp-controller="Account" asp-action="Logout" method="post"><button class="ghost">Sign out</button></form></aside><main><header><div><small>MANAGEMENT WORKSPACE</small><h1>@ViewData["Title"]</h1></div><div class="identity"><b>@User.Identity?.Name</b><span>@(User.IsInRole(Roles.Administrator)?"Administrator":"Content reviewer")</span></div></header>@if(TempData["Success"] is string s){<div class="flash success" role="status">✓ @s</div>}@if(TempData["Error"] is string e){<div class="flash error" role="alert">! @e</div>}@RenderBody()</main></body></html>
