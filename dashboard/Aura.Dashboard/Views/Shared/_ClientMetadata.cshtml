@model ClientMetadata?
@{
    var title = ViewData["MetadataTitle"] as string ?? "Client metadata";
    var emptyMessage = ViewData["MetadataEmptyMessage"] as string ?? "Client metadata was not captured.";
}

<div class="client-metadata">
    <h4>@title</h4>
    @if (Model is null)
    {
        <p class="metadata-empty">@emptyMessage</p>
    }
    else
    {
        <dl>
            <dt>IP address</dt><dd>@(Model.IpAddress ?? "Not available")</dd>
            <dt>Browser</dt><dd>@(Model.Browser ?? "Not available")</dd>
            <dt>Device</dt><dd>@(Model.Device ?? "Not available")</dd>
            <dt>Platform</dt><dd>@(Model.Platform ?? "Not available")</dd>
            <dt>Language</dt><dd>@(Model.Language ?? "Not available")</dd>
            <dt>Location</dt><dd>@FormatLocation(Model)</dd>
            <dt>Time zone</dt><dd>@(Model.TimeZone ?? "Not available")</dd>
            <dt>User agent</dt><dd class="user-agent">@(Model.UserAgent ?? "Not available")</dd>
        </dl>
    }
</div>

@functions {
    private static string FormatLocation(ClientMetadata metadata)
    {
        var parts = new[] { metadata.City, metadata.Region, metadata.Country }
            .Where(value => !string.IsNullOrWhiteSpace(value));
        return parts.Any() ? string.Join(", ", parts) : "Not available";
    }
}
