@model ConfigurationViewModel
@{
    ViewData["Title"] = "Platform configuration";
}

<div class="configuration-shell">
    <form method="post" class="configuration-form">
        <div class="configuration-heading">
            <div>
                <span class="eyebrow">PUBLIC ACCESS</span>
                <h3>Registration and uploads</h3>
                <p>Choose which community features are currently available.</p>
            </div>
            <span class="live-status"><i></i> Live settings</span>
        </div>

        <div class="setting-list">
            <div class="setting-row">
                <div class="setting-symbol registration-symbol" aria-hidden="true">+</div>
                <div class="setting-copy">
                    <label asp-for="RegistrationEnabled">New member registration</label>
                    <small>Allow visitors to create an Aura account and join the community.</small>
                    <span class="setting-state">@(Model.RegistrationEnabled ? "Currently available" : "Currently paused")</span>
                </div>
                <label class="switch">
                    <input asp-for="RegistrationEnabled" type="checkbox">
                    <span class="switch-track" aria-hidden="true"></span>
                    <span class="sr-only">Allow new member registration</span>
                </label>
            </div>
            <div class="setting-row">
                <div class="setting-symbol upload-symbol" aria-hidden="true">↑</div>
                <div class="setting-copy">
                    <label asp-for="UploadsEnabled">Member media uploads</label>
                    <small>Allow signed-in members to upload and submit new media.</small>
                    <span class="setting-state">@(Model.UploadsEnabled ? "Currently available" : "Currently paused")</span>
                </div>
                <label class="switch">
                    <input asp-for="UploadsEnabled" type="checkbox">
                    <span class="switch-track" aria-hidden="true"></span>
                    <span class="sr-only">Allow member media uploads</span>
                </label>
            </div>
        </div>

        <div class="configuration-footer">
            <p><strong>Ready to publish?</strong><span>Your selections will apply immediately.</span></p>
            <button type="submit">Save changes <span aria-hidden="true">→</span></button>
        </div>
    </form>
</div>
